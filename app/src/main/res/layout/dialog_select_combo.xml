<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Thanh gạch trên đầu Bottom Sheet -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#D0D0D0" />

    <!-- Header Tiêu đề & Nút đóng -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHỌN COMBO BẮP NƯỚC"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tiết kiệm hơn khi mua kèm vé xem phim"
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_close_combo_dialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#666666" />
    </RelativeLayout>

    <!-- DANH SÁCH KHUNG CÁC COMBO -->

    <!-- Combo 1 -->
    <LinearLayout
        android:id="@+id/card_combo_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_option_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Combo 1: 1 Bắp + 1 Nước Vừa"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="1 Bắp ngọt 60oz + 1 Nước ngọt 22oz"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_price_combo_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 69.000 đ"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Combo 2 -->
    <LinearLayout
        android:id="@+id/card_combo_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_option_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Combo 2: 1 Bắp + 2 Nước Lớn"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="1 Bắp ngọt 60oz + 2 Nước ngọt 32oz"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_price_combo_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 89.000 đ"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Combo 3 -->
    <LinearLayout
        android:id="@+id/card_combo_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_option_card_unselected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Combo 3: 2 Bắp + 2 Nước + Snack"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 Bắp ngọt 60oz + 2 Nước 32oz + 1 Snack"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_price_combo_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 129.000 đ"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
