<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    tools:context=".SignUpActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Ảnh Banner Phim -->
        <ImageView
            android:id="@+id/imgBanner"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_background_login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Chữ Booking Movie Tickets -->
        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.04"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="BOOKING MOVIE TICKETS"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Container Logo CQS Cinema -->
        <LinearLayout
            android:id="@+id/llLogoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgBanner">

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="CQS "
                        android:textColor="#B71C1C"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="Cinema"
                        android:textColor="#000000"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.1dp"
                    android:layout_marginTop="1dp"
                    android:background="#000000" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_marginTop="2dp"
                    android:background="#000000" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tiêu đề Sign Up -->
        <TextView
            android:id="@+id/tvSignUpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:text="Sign Up"
            android:textColor="#707070"
            android:textSize="40sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llLogoContainer" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Please create an account"
            android:textColor="#9E9E9E"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/tvSignUpTitle"
            app:layout_constraintTop_toBottomOf="@id/tvSignUpTitle" />

        <!-- 1. FULL NAME -->
        <EditText
            android:id="@+id/edtFullName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#B0B0B0"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:paddingBottom="10dp"
            android:textColor="#000000"
            android:textColorHint="#B0B0B0"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvSignUpTitle"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <!-- 2. DATE OF BIRTH -->
        <EditText
            android:id="@+id/edtDob"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#B0B0B0"
            android:clickable="true"
            android:cursorVisible="false"
            android:drawableEnd="@android:drawable/arrow_down_float"
            android:drawableTint="#9E9E9E"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:hint="Date of Birth"
            android:paddingBottom="10dp"
            android:textColor="#000000"
            android:textColorHint="#B0B0B0"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvSignUpTitle"
            app:layout_constraintTop_toBottomOf="@id/edtFullName" />

        <!-- 3. GENDER (Male, Female, Other - buttonTint=#B71C1C) -->
        <LinearLayout
            android:id="@+id/llGender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvSignUpTitle"
            app:layout_constraintTop_toBottomOf="@id/edtDob">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="Gender"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Male"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:buttonTint="@color/radio_button_tint"
                    app:buttonTint="@color/radio_button_tint" />

                <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Female"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:buttonTint="@color/radio_button_tint"
                    app:buttonTint="@color/radio_button_tint" />

                <RadioButton
                    android:id="@+id/rbOther"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Other"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:buttonTint="@color/radio_button_tint"
                    app:buttonTint="@color/radio_button_tint" />
            </RadioGroup>
        </LinearLayout>

        <!-- 4. PHONE NUMBER -->
        <EditText
            android:id="@+id/edtPhone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#B0B0B0"
            android:hint="Phone Number"
            android:inputType="phone"
            android:paddingBottom="10dp"
            android:textColor="#000000"
            android:textColorHint="#B0B0B0"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvSignUpTitle"
            app:layout_constraintTop_toBottomOf="@id/llGender" />

        <!-- 5. EMAIL ADDRESS -->
        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#B0B0B0"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:paddingBottom="10dp"
            android:textColor="#000000"
            android:textColorHint="#B0B0B0"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvSignUpTitle"
            app:layout_constraintTop_toBottomOf="@id/edtPhone" />

        <!-- 6. PASSWORD -->
        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#B0B0B0"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingBottom="10dp"
            android:textColor="#000000"
            android:textColorHint="#B0B0B0"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvSignUpTitle"
            app:layout_constraintTop_toBottomOf="@id/edtEmail" />

        <!-- 7. CONFIRM PASSWORD -->
        <EditText
            android:id="@+id/edtConfirmPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#B0B0B0"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:paddingBottom="10dp"
            android:textColor="#000000"
            android:textColorHint="#B0B0B0"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvSignUpTitle"
            app:layout_constraintTop_toBottomOf="@id/edtPassword" />

        <!-- NÚT SIGN UP -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUp"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#B71C1C"
            android:fontFamily="serif"
            android:text="Sign Up"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:layout_constraintEnd_toEndOf="@id/edtConfirmPassword"
            app:layout_constraintStart_toStartOf="@id/edtConfirmPassword"
            app:layout_constraintTop_toBottomOf="@id/edtConfirmPassword" />

        <!-- LIÊN KẾT LOG IN -->
        <LinearLayout
            android:id="@+id/llLogIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="80dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSignUp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="#333333"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log in"
                android:textColor="#B71C1C"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
