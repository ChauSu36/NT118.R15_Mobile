<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_banner_gradient"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Phần bên trái: Thông tin chữ và nút bấm (chiếm tỷ lệ rộng hơn) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.4"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <!-- Badge "HOT PHIM THÁNG" -->
        <TextView
            android:id="@+id/tv_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_hot"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="HOT PHIM THÁNG"
            android:textColor="#000000"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Tên phim -->
        <TextView
            android:id="@+id/tv_banner_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="LẬT MẶT 7: ONE WISH"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Mô tả ngắn -->
        <TextView
            android:id="@+id/tv_banner_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Khởi chiếu toàn quốc"
            android:textColor="#F0E0E0"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Nút Chi tiết phim -->
        <TextView
            android:id="@+id/btn_banner_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Chi tiết phim"
            android:textColor="@color/color_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true" />

    </LinearLayout>

    <!-- Phần bên phải: Poster phim đứng nằm gọn gàng bên phải trong CardView bo góc -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:layout_weight="0.9"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/color_poster_placeholder">

        <ImageView
            android:id="@+id/img_banner_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Banner Poster" />

    </androidx.cardview.widget.CardView>

</LinearLayout>
