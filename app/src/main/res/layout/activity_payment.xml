<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5FFFF"
    android:fitsSystemWindows="true">

    <!-- ===== HEADER ===== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center"
        android:padding="16dp"
        android:text="THANH TOÁN ĐƠN HÀNG"
        android:textColor="#000000"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- ===== NỘI DUNG CUỘN ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ===== ĐẾM NGƯỢC ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_countdown_banner"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱"
                    android:layout_marginEnd="6dp"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tự động hủy sau: "
                    android:textColor="#E65100"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:00"
                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ===== CHỌN PHƯƠNG THỨC THANH TOÁN (THU GỌN) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="12dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chọn phương thức thanh toán"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Chuyển khoản ngân hàng -->
                <LinearLayout
                    android:id="@+id/row_bank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_option_card_selected"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iv_radio_bank"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_radio_selected" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="📱"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_label_bank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Chuyển khoản ngân hàng"
                        android:textColor="#D32F2F"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Thẻ ATM / Visa / Mastercard -->
                <LinearLayout
                    android:id="@+id/row_atm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_option_card_unselected"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iv_radio_atm"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_radio_unselected" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="💳"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_label_atm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Thẻ ATM / Visa / Mastercard"
                        android:textColor="#424242"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Tiền mặt tại rạp -->
                <LinearLayout
                    android:id="@+id/row_cash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_option_card_unselected"
                    android:padding="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iv_radio_cash"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_radio_unselected" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="💵"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_label_cash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Thanh toán tiền mặt trực tiếp tại rạp"
                        android:textColor="#424242"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== KHUNG MÃ QR (THU GỌN) ===== -->
            <LinearLayout
                android:id="@+id/layout_qr_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/bg_card_qr_border"
                android:padding="12dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số tiền cần thanh toán"
                    android:textColor="#757575"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="279.000 đ"
                    android:textColor="#D32F2F"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="#EEEEEE" />

                <!-- Ô QR nhỏ gọn -->
                <FrameLayout
                    android:layout_width="130dp"
                    android:layout_height="130dp">

                    <View
                        android:id="@+id/iv_qr_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_qr_placeholder" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Quét mã QR bằng App Ngân hàng hoặc Ví"
                    android:textColor="#757575"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/layout_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_status_pill_waiting"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="8dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_dot_green" />

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Đang chờ giao dịch..."
                        android:textColor="#2E7D32"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nội dung: "
                        android:textColor="#616161"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_transfer_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CQS279001"
                        android:textColor="#D32F2F"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== NÚT HỦY THANH TOÁN (CỐ ĐỊNH Ở ĐÁY, KHÔNG BAO GIỜ BỊ CHE) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:padding="12dp">

        <TextView
            android:id="@+id/btn_cancel_payment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_outline"
            android:gravity="center"
            android:padding="13dp"
            android:text="HỦY THANH TOÁN"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
