<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- Ảnh Banner Phim -->
    <ImageView
        android:id="@+id/imgBanner"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_background_login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Chữ Booking Movie Tickets màu đỏ với hiệu ứng đổ bóng đen để nổi bật trên banner -->
    <TextView
        android:id="@+id/tvBannerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-condensed"
        android:letterSpacing="0.04"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="3"
        android:text="BOOKING MOVIE TICKETS"
        android:textColor="#90AEA2"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nhóm chứa Logo và CQS Cinema với gạch chân kép -->
    <LinearLayout
        android:id="@+id/llLogoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgBanner">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:src="@drawable/ic_logo" />

        <!-- Container chữ CQS Cinema + Gạch chân kép -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="CQS "
                    android:textColor="#B71C1C"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="Cinema"
                    android:textColor="#000000"
                    android:textSize="32sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Đường gạch chân kép bên dưới CQS Cinema -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1.1dp"
                android:layout_marginTop="1dp"
                android:background="#000000" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginTop="2dp"
                android:background="#000000" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tiêu đề Reset Password -->
    <TextView
        android:id="@+id/tvLoginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="28dp"
        android:text="THAY ĐỔI MẬT KHẨU"
        android:textColor="#707070"
        android:textSize="35sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llLogoContainer" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Vui lòng nhập địa chỉ email khi tạo tài khoản này"
        android:textColor="#9E9E9E"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@id/tvLoginTitle"
        app:layout_constraintTop_toBottomOf="@id/tvLoginTitle" />

    <!-- Ô nhập Email Address -->
    <EditText
        android:id="@+id/edtEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#B0B0B0"
        android:hint="Địa chỉ email"
        android:inputType="textEmailAddress"
        android:paddingBottom="12dp"
        android:textColor="#000000"
        android:textColorHint="#B0B0B0"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvLoginTitle"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

    <!-- Ô nhập Password Mới (Kèm Icon Con Mắt) -->
    <RelativeLayout
        android:id="@+id/containerNewPassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvLoginTitle"
        app:layout_constraintTop_toBottomOf="@id/edtEmail">

        <EditText
            android:id="@+id/edtNewPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/ivToggleNewPassword"
            android:backgroundTint="#B0B0B0"
            android:hint="Mật khẩu mới"
            android:inputType="textPassword"
            android:paddingBottom="12dp"
            android:textColor="#000000"
            android:textColorHint="#B0B0B0"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivToggleNewPassword"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="4dp"
            android:src="@drawable/ic_eye_invisible" />
    </RelativeLayout>

    <!-- Ô nhập Confirm Password (Kèm Icon Con Mắt) -->
    <RelativeLayout
        android:id="@+id/containerConfirmPassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tvLoginTitle"
        app:layout_constraintTop_toBottomOf="@id/containerNewPassword">

        <EditText
            android:id="@+id/edtConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/ivToggleConfirmPassword"
            android:backgroundTint="#B0B0B0"
            android:hint="Xác nhận mật khẩu"
            android:inputType="textPassword"
            android:paddingBottom="12dp"
            android:textColor="#000000"
            android:textColorHint="#B0B0B0"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivToggleConfirmPassword"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="4dp"
            android:src="@drawable/ic_eye_invisible" />
    </RelativeLayout>

    <!-- Nút Thay đổi mật khẩu -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnResetPassword"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#B71C1C"
        android:fontFamily="serif"
        android:text="Thay đổi mật khẩu "
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toEndOf="@id/containerConfirmPassword"
        app:layout_constraintStart_toStartOf="@id/containerConfirmPassword"
        app:layout_constraintTop_toBottomOf="@+id/containerConfirmPassword" />

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:clickable="true"
        android:drawableStart="@drawable/ic_back"
        android:focusable="true"
        android:padding="10dp"
        android:textColor="#707070"
        android:textSize="0sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnResetPassword" />
</androidx.constraintlayout.widget.ConstraintLayout>
