<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- ===== 1. HEADER TITLE (RelativeLayout) ===== -->
    <RelativeLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="#1A1A1A" />

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="ĐỔI MẬT KHẨU"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- ===== 2. NỘI DUNG FORM ĐỔI MẬT KHẨU ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CARD KHUNG ĐỔI MẬT KHẨU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- BANNER CẢNH BÁO BẢO MẬT (MÀU CAM) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_security_tip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Mật khẩu mới phải có ít nhất 8 ký tự, bao gồm chữ và số để tăng cường bảo mật."
                        android:textColor="#E65100"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- ===== FIELD 1: MẬT KHẨU HIỆN TẠI ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Mật khẩu hiện tại *"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/container_current_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text_field">

                    <EditText
                        android:id="@+id/et_current_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/iv_toggle_current"
                        android:background="@null"
                        android:hint="••••••••••••"
                        android:inputType="textPassword"
                        android:padding="14dp"
                        android:textColor="#000000"
                        android:textColorHint="#999999"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/iv_toggle_current"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="6dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_eye_invisible" />
                </RelativeLayout>

                <!-- QUÊN MẬT KHẨU LINK -->
                <TextView
                    android:id="@+id/tv_forgot_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="6dp"
                    android:text="Quên mật khẩu?"
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- ===== FIELD 2: MẬT KHẨU MỚI ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Mật khẩu mới *"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/container_new_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text_field">

                    <EditText
                        android:id="@+id/et_new_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/iv_toggle_new"
                        android:background="@null"
                        android:hint="••••••••••••"
                        android:inputType="textPassword"
                        android:padding="14dp"
                        android:textColor="#000000"
                        android:textColorHint="#999999"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/iv_toggle_new"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="6dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_eye_invisible" />
                </RelativeLayout>

                <!-- LƯỚI QUY TẮC MẬT KHẨU -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_rule_min_length"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="○ Tối thiểu 8 ký tự"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_rule_uppercase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="○ Có ký tự in hoa (A-Z)"
                            android:textColor="#757575"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_rule_digit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="○ Có ít nhất 1 chữ số"
                            android:textColor="#757575"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_rule_special"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="○ Có ký tự đặc biệt (@,#...)"
                            android:textColor="#757575"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== FIELD 3: NHẬP LẠI MẬT KHẨU MỚI ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Nhập lại mật khẩu mới *"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/container_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_text_field">

                    <EditText
                        android:id="@+id/et_confirm_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/iv_toggle_confirm"
                        android:background="@null"
                        android:hint="Nhập lại mật khẩu mới của bạn"
                        android:inputType="textPassword"
                        android:padding="14dp"
                        android:textColor="#000000"
                        android:textColorHint="#999999"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/iv_toggle_confirm"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="6dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_eye_invisible" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="#EEEEEE" />

                <!-- ===== NÚT XÁC NHẬN & HỦY ===== -->
                <TextView
                    android:id="@+id/btn_confirm_change"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="XÁC NHẬN ĐỔI MẬT KHẨU"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_cancel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="HỦY BỎ"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
