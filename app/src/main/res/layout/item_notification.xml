<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- PHẦN THÔNG TIN CƠ BẢN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- ICON THÔNG BÁO -->
        <ImageView
            android:id="@+id/imgNotificationIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_circle_pink"
            android:padding="10dp"
            android:src="@drawable/ic_notification"
            app:tint="#D32F2F" />

        <!-- NỘI DUNG CHÍNH -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNotificationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NHẮC NHỚ SUẤT CHIẾU"
                android:textColor="#D32F2F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNotificationSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="LẬT MẶT 7: ONE WISH"
                android:textColor="#1A1A1A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNotificationDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Suất: 19:30"
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- THỜI GIAN -->
        <TextView
            android:id="@+id/tvNotificationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30 phút nữa"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- NÚT MÃ QR (ĐẤO VỚI REMINDER) -->
    <Button
        android:id="@+id/btnNotificationQr"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_primary"
        android:text="XEM MÃ QR SOÁT VÉ"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@null" />

    <!-- LINK CHỮ ĐỎ (ĐỐI VỚI SUCCESS/VOUCHER) -->
    <TextView
        android:id="@+id/tvNotificationActionLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Xem chi tiết hóa đơn >"
        android:textColor="#D32F2F"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- ĐƯỜNG PHÂN CÁCH -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#F0F0F0" />
</LinearLayout>