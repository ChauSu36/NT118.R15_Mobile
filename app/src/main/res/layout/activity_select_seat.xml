<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true">

    <!-- 1. HEADER -->
    <RelativeLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHỌN GHẾ &amp; ƯU ĐÃI"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_header_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CQS Nguyễn Trãi • 18:30 • Phòng 01"
                android:textColor="#D32F2F"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. NỘI DUNG CUỘN (SƠ ĐỒ GHẾ + CARD THÔNG TIN) -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_voucher_bar"
        app:layout_constraintTop_toBottomOf="@+id/layout_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- MÀN HÌNH CHIẾU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="200dp"
                    android:layout_height="3dp"
                    android:background="#D32F2F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="MÀN HÌNH CHIẾU"
                    android:textColor="#D32F2F"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- SƠ ĐỒ GHẾ MA TRẬN MẪU FIGMA -->
            <LinearLayout
                android:id="@+id/layout_seat_matrix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- HÀNG A -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="A" android:textColor="#000" android:textStyle="bold" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#E0E0E0" android:gravity="center" android:text="1" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#E0E0E0" android:gravity="center" android:text="2" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FFFFFF" android:gravity="center" android:text="3" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FFFFFF" android:gravity="center" android:text="4" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FFFFFF" android:gravity="center" android:text="5" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FFFFFF" android:gravity="center" android:text="6" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#E0E0E0" android:gravity="center" android:text="7" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#E0E0E0" android:gravity="center" android:text="8" android:textSize="11sp" />
                </LinearLayout>

                <!-- HÀNG B -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="B" android:textColor="#000" android:textStyle="bold" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FFFFFF" android:gravity="center" android:text="1" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FFFFFF" android:gravity="center" android:text="2" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FFFFFF" android:gravity="center" android:text="3" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#E0E0E0" android:gravity="center" android:text="4" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#E0E0E0" android:gravity="center" android:text="5" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FFFFFF" android:gravity="center" android:text="6" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FFFFFF" android:gravity="center" android:text="7" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FFFFFF" android:gravity="center" android:text="8" android:textSize="11sp" />
                </LinearLayout>

                <!-- HÀNG C (VIP) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="C" android:textColor="#000" android:textStyle="bold" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="1" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="2" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="3" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#E0E0E0" android:gravity="center" android:text="4" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#E0E0E0" android:gravity="center" android:text="5" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="6" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="7" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="8" android:textColor="#FFF" android:textSize="11sp" />
                </LinearLayout>

                <!-- HÀNG D (VIP) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="D" android:textColor="#000" android:textStyle="bold" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="1" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="2" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="3" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="4" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="5" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="6" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="7" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="8" android:textColor="#FFF" android:textSize="11sp" />
                </LinearLayout>

                <!-- HÀNG F (VIP & ĐANG CHỌN) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="F" android:textColor="#000" android:textStyle="bold" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="1" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="2" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="3" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="4" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#4CAF50" android:gravity="center" android:text="5" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#4CAF50" android:gravity="center" android:text="6" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="7" android:textColor="#FFF" android:textSize="11sp" />
                    <TextView android:layout_width="26dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#FF9800" android:gravity="center" android:text="8" android:textColor="#FFF" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CHÚ THÍCH LOẠI GHẾ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_rounded"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⬜ Thường" android:textSize="11sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="🟧 VIP" android:textSize="11sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="🟩 Đang chọn" android:textSize="11sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="⬛ Đã bán" android:textSize="11sp" />
            </LinearLayout>

            <!-- CARD TỔNG TIỀN TẠM TÍNH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_rounded"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tv_movie_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LẬT MẶT 7: ONE WISH"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cinema_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="CQS Nguyễn Trãi • Phòng 01 • 18:30 (30/09)"
                    android:textColor="#666666"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#E0E0E0" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_ticket_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiền vé (2x Ghế VIP F5, F6):"
                        android:textColor="#444444"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tv_ticket_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="220.000 đ"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiền Combo Bắp Nước:"
                        android:textColor="#444444"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tv_combo_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="+ 89.000 đ"
                        android:textColor="#000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mã giảm giá:"
                        android:textColor="#388E3C"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/tv_discount_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="- 30.000 đ"
                        android:textColor="#388E3C"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#E0E0E0" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TỔNG THANH TOÁN:"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_total_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="279.000 đ"
                        android:textColor="#D32F2F"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 3. BAR MÃ GIẢM GIÁ / VOUCHER -->
    <RelativeLayout
        android:id="@+id/layout_voucher_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF5F5"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_bottom_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ic_voucher"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_voucher_icon"
            android:padding="5dp"
            android:src="@drawable/ic_discount_tag"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/ic_voucher"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã giảm giá / Voucher"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_applied_voucher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã áp dụng mã CQS30K"
                android:textColor="#D32F2F"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_open_voucher"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/arrow_up_float"
            app:tint="#000000" />

        <TextView
            android:id="@+id/tv_voucher_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btn_open_voucher"
            android:text="Giảm -30.000 đ"
            android:textColor="#388E3C"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 4. BOTTOM ACTION BUTTONS -->
    <LinearLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_combo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="🍿 COMBO (+89k)"
                android:textColor="#D32F2F"
                android:textSize="12sp"
                app:cornerRadius="24dp"
                app:strokeColor="#D32F2F"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_book_now"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:backgroundTint="#D32F2F"
                android:text="ĐẶT VÉ NGAY (279K)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Bấm &quot;Đặt vé ngay&quot; đồng nghĩa bạn đồng ý với Điều khoản CQS Cinema"
            android:textColor="#888888"
            android:textSize="9sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>