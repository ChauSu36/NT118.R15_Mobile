<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="6dp">

    <!-- Poster (placeholder tối màu) + 2 badge đè lên -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_poster_placeholder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="POSTER 2:3"
            android:textColor="#757575"
            android:textSize="12sp" />

        <!-- Badge độ tuổi (góc trên-trái) -->
        <TextView
            android:id="@+id/tv_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_badge_age_c16"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="C16"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Badge điểm đánh giá (góc trên-phải) -->
        <TextView
            android:id="@+id/tv_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_badge_rating"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="★ 4.8"
            android:textColor="@color/color_accent_yellow"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Tên phim -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="MAI (2024)"
        android:textColor="#000000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Thể loại • thời lượng -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tình cảm • 131p"
        android:textColor="@color/color_text_gray"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Nút Chi tiết phim -->
    <TextView
        android:id="@+id/btn_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:text="Chi tiết phim"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
